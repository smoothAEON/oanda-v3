# Market Signal MCP environment template
# Copy to `.env` and fill in your OANDA credentials.
#
# PowerShell:
#   Copy-Item .env.example .env
#
# Precedence:
#   code defaults < .env < explicit environment variables

# Required OANDA credentials
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice

# Local runtime settings
LOG_LEVEL=INFO
LOG_JSON=false
DEFAULT_CANDLE_COUNT=500
DEFAULT_SWING_LENGTH=10
ACCOUNT_CURRENCY=USD
JOURNAL_TIMEZONE=Asia/Singapore
CALENDAR_REFRESH_HOURS=1
MACRO_REFRESH_HOURS=1

# Optional local store path. Parent directory must already exist.
# Existing TinyDB data can be reused by copying the old bot.json here.
TINYDB_PATH=data/bot.json
