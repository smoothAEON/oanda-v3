# Market Signal Bot V3 environment template
# Save this file as `.env` using UTF-8 encoding.
# PowerShell bootstrap:
#   Copy-Item .env.example .env
# Precedence:
#   code defaults < .env < explicit environment variables
# TA-Lib note:
#   Install the matching Windows wheel if pip cannot build TA-Lib from source.

# Required provider credentials
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice

# Required Telegram runtime settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_PASSWORD=your_bot_password_here
TELEGRAM_ADMIN_IDS=123456789,987654321

# Runtime defaults from config/settings.py
# Runtime-mutable in Stage 02: LOG_LEVEL, SCAN_INTERVAL_MINUTES
# Startup-only in Stage 02: all secrets, provider identity, and remaining keys below
LOG_LEVEL=INFO
LOG_JSON=false
DEFAULT_CANDLE_COUNT=500
DEFAULT_SWING_LENGTH=10
SCAN_INTERVAL_MINUTES=5
POLL_INTERVAL_SECONDS=30
JOURNAL_TIMEZONE=Asia/Singapore
STREAM_INSTRUMENTS=XAU_USD,SPX500_USD,XAG_USD,EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,USD_CHF,NZD_USD,EUR_GBP,EUR_JPY,GBP_JPY,BCO_USD,WTICO_USD,JP225_USD
MAE_MFE_MIN_PIP_MOVE=0.5
ACCOUNT_CURRENCY=USD
CALENDAR_REFRESH_HOURS=1
MACRO_REFRESH_HOURS=1
# Optional. Local default keeps persistence beside the repo in data/bot.json.
# Railway volume deployment: leave TINYDB_PATH unset, or set it to the mounted volume path.
# Example: TINYDB_PATH=/data/bot.json
# TINYDB_PATH=data/bot.json

# Optional embedded MCP HTTP surface
# Railway expects the app to listen on 0.0.0.0 and the configured service port.
MCP_HTTP_ENABLED=false
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080
MCP_HTTP_PATH=/mcp
MCP_HTTP_API_KEY=change_me
# Defaults to TELEGRAM_CHAT_ID when blank
MCP_DEFAULT_CHAT_ID=
